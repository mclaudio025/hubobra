# Database (Supabase PostgreSQL ou local Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage & Services (Plano Pago Pro - CDN & On-the-fly Image Transforms)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_BUCKET_NAME="products"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS & Domínios Permitidos
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://seudominio.com.br,https://www.seudominio.com.br,https://admin.seudominio.com.br"

# Local Upload Fallback
UPLOAD_PATH="./uploads"
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE=10485760

# Redis Cache (opcional se usar cache em memória)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Cache
CACHE_TTL=300
CACHE_MAX_ITEMS=1000

# n8n & Wazapi Webhooks
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"
WAZAPI_BASE_URL="http://localhost:8080"
WAZAPI_INSTANCE_NAME="loja-moderna"
WAZAPI_API_KEY="your-wazapi-key"